<div class="prize-row"><b>3rd</b><span class="amount">₹5,000</span></div>
<div class="prize-row"><b>4th</b><span class="amount">₹3,000</span></div>
<div class="prize-row"><b>5th</b><span class="amount">₹2,000</span></div>
<div class="prize-row"><b>6th - 10th</b><span class="amount">₹1,000 each</span></div>
</div>

<div class="prize-card">
<h3>🏃 7 KM – MEN (14+)</h3>
<div class="prize-row"><b>1st</b><span class="amount">₹7,000</span></div>
<div class="prize-row"><b>2nd</b><span class="amount">₹4,000</span></div>
<div class="prize-row"><b>3rd</b><span class="amount">₹3,000</span></div>
