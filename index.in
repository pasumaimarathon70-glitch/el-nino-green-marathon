<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EL NINO GREEN MARATHON 2026</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f1e7;
  color:#173d2b;
  line-height:1.5;
}
a{text-decoration:none;color:inherit}

:root{
  --green:#0b5d3b;
  --dark:#063b27;
  --light:#f5f1e7;
  --gold:#d5a62a;
  --cream:#fffaf0;
  --shadow:0 12px 35px rgba(0,0,0,.12);
}

/* HERO */
.hero{
  min-height:100vh;
  padding:25px 18px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:
    radial-gradient(circle at top right,rgba(213,166,42,.18),transparent 35%),
    linear-gradient(135deg,#063b27,#0b6d45 55%,#154f35);
  color:white;
  position:relative;
  overflow:hidden;
}
.hero:before{
  content:"🌿";
  position:absolute;
  font-size:180px;
  opacity:.06;
  left:-30px;
  bottom:-30px;
}
.hero-content{max-width:900px;position:relative;z-index:2}
.badge{
  display:inline-block;
  padding:9px 18px;
  border:1px solid rgba(255,255,255,.35);
  border-radius:30px;
  font-size:13px;
  letter-spacing:2px;
  margin-bottom:20px;
}
.hero h1{
  font-size:clamp(38px,8vw,78px);
  line-height:1;
  font-weight:900;
  letter-spacing:-2px;
}
.hero h1 span{color:#f2cb57}
.hero h2{
  margin:18px 0 8px;
  font-size:clamp(18px,4vw,28px);
}
.hero-info{
  margin:22px auto;
  display:grid;
  gap:8px;
  font-size:16px;
}
.hero-info strong{color:#f2cb57}
.countdown{
  display:flex;
  justify-content:center;
  gap:10px;
  margin:25px 0;
  flex-wrap:wrap;
}
.time-box{
  min-width:72px;
  padding:12px 8px;
  border-radius:14px;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.2);
}
.time-box b{display:block;font-size:25px;color:#f2cb57}
.time-box small{font-size:10px;letter-spacing:1px}
.buttons{
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  margin-top:25px;
}
.btn{
  padding:14px 22px;
  border-radius:50px;
  font-weight:800;
  border:2px solid transparent;
  cursor:pointer;
  transition:.25s;
}
.btn:hover{transform:translateY(-3px)}
.btn-main{background:#f2cb57;color:#173d2b}
.btn-light{border-color:white;color:white}

/* SECTIONS */
section{padding:75px 18px}
.container{max-width:1100px;margin:auto}
.section-label{
  color:#b48612;
  font-size:13px;
  font-weight:900;
  letter-spacing:3px;
  margin-bottom:8px;
}
.section-title{
  font-size:clamp(30px,6vw,50px);
  color:var(--dark);
  line-height:1.05;
  margin-bottom:25px;
}
.about{
  background:var(--cream);
}
.about-text{
  max-width:900px;
  font-size:17px;
  color:#4a5a50;
}

/* BENEFITS */
.benefits{background:#e9efe8}
.benefit-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:20px;
}
.benefit{
  background:white;
  border-radius:22px;
  overflow:hidden;
  box-shadow:var(--shadow);
  transition:.25s;
}
.benefit:hover{transform:translateY(-6px)}
.visual{
  height:150px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(145deg,#dfeee4,#fff9e9);
  font-size:75px;
}
.benefit h3{
  padding:18px 18px 4px;
  font-size:19px;
}
.benefit p{
  padding:0 18px 20px;
  color:#6b746e;
  font-size:14px;
}

/* PRIZE */
.prize-section{background:#fffaf0}
.prize-note{
  background:#0b5d3b;
  color:white;
  padding:18px;
  border-radius:16px;
  margin-bottom:25px;
  font-weight:bold;
}
.tabs{
  display:flex;
  gap:10px;
  margin-bottom:25px;
}
.tab{
  flex:1;
  padding:14px;
  border:0;
  border-radius:12px;
  font-weight:900;
  background:#dce7df;
  color:#0b5d3b;
  cursor:pointer;
}
.tab.active{
  background:#0b5d3b;
  color:white;
}
.prize-card{
  background:white;
  border-radius:20px;
  padding:22px;
  margin-bottom:20px;
  box-shadow:0 8px 25px rgba(0,0,0,.08);
  border-left:6px solid var(--gold);
}
.prize-card h3{
  color:#0b5d3b;
  margin-bottom:15px;
}
.prize-row{
  display:flex;
  justify-content:space-between;
  padding:9px 4px;
  border-bottom:1px solid #eee;
}
.prize-row:last-child{border-bottom:0}
.prize-row b{color:#173d2b}
.amount{font-weight:900;color:#a87800}

/* REGISTRATION */
.register{
  background:linear-gradient(135deg,#063b27,#0b5d3b);
  color:white;
}
.form-box{
  background:white;
  color:#173d2b;
  max-width:900px;
  margin:auto;
  padding:25px;
  border-radius:25px;
  box-shadow:var(--shadow);
}
.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:16px;
}
.field{display:flex;flex-direction:column;gap:7px}
.field.full{grid-column:1/-1}
label{font-weight:800;font-size:14px}
input,select,textarea{
  width:100%;
  padding:13px;
  border:1px solid #d7ddd8;
  border-radius:10px;
  font:inherit;
  outline:none;
}
input:focus,select:focus,textarea:focus{border-color:#0b5d3b}
textarea{min-height:90px;resize:vertical}
.submit{
  width:100%;
  margin-top:20px;
  padding:15px;
  border:0;
  border-radius:12px;
  background:#d5a62a;
  color:#173d2b;
  font-size:17px;
  font-weight:900;
  cursor:pointer;
}
.fee-box{
  margin-top:15px;
  padding:13px;
  background:#edf5ef;
  border-radius:10px;
  font-weight:800;
}

/* LOCATION */
.location{
  text-align:center;
  background:#f5f1e7;
}
.map-btn{
  display:inline-block;
  margin-top:18px;
  background:#0b5d3b;
  color:white;
  padding:15px 25px;
  border-radius:50px;
  font-weight:900;
}

/* FOOTER */
footer{
  background:#042b1d;
  color:white;
  text-align:center;
  padding:35px 18px;
}
footer h3{color:#f2cb57;margin-bottom:10px}
footer p{color:#d6dfd9;margin:6px 0}
.footer-brand{
  margin-top:20px;
  font-weight:900;
  letter-spacing:2px;
}

/* MOBILE */
@media(max-width:650px){
  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:auto}
  .hero{min-height:95vh}
  .prize-row{font-size:14px}
}
</style>
</head>

<body>

<!-- HERO -->
<header class="hero">
<div class="hero-content">

<div class="badge">🌿 PASUMAI IYENGARGAL PRESENTS</div>

<h1>EL NINO <span>GREEN</span><br>MARATHON 2026</h1>

<h2>RUN FOR FITNESS • RUN FOR NATURE</h2>

<div class="hero-info">
<p>📅 <strong>11 OCTOBER 2026 • SUNDAY</strong></p>
<p>⏰ <strong>5:30 AM</strong></p>
<p>📍 K K Vidhyalaya Matric Higher Secondary School</p>
<p>Kaduvettipalayam, Annur, Coimbatore, Tamil Nadu</p>
</div>

<div class="countdown">
<div class="time-box"><b id="days">00</b><small>DAYS</small></div>
<div class="time-box"><b id="hours">00</b><small>HOURS</small></div>
<div class="time-box"><b id="minutes">00</b><small>MINUTES</small></div>
<div class="time-box"><b id="seconds">00</b><small>SECONDS</small></div>
</div>

<p>Registration closes: <strong style="color:#f2cb57">02 OCTOBER 2026</strong></p>

<div class="buttons">
<a href="#register" class="btn btn-main">🏃 REGISTRATION</a>
<a href="#prizes" class="btn btn-light">🏆 PRIZE DETAILS</a>
<button class="btn btn-light" onclick="openGoogleMaps()">📍 LOCATION</button>
</div>

</div>
</header>

<!-- ABOUT -->
<section class="about">
<div class="container">
<div class="section-label">ABOUT THE EVENT</div>
<h2 class="section-title">FITNESS WITH A PURPOSE.</h2>

<p class="about-text">
EL NINO GREEN MARATHON 2026 is a community-focused running event inspired by the environmental impact of El Niño and the growing need for awareness about climate change, rising temperatures, water conservation and a greener future. Our mission is to connect fitness with environmental responsibility by encouraging people to stay healthy, understand climate challenges, conserve water, protect nature and make sustainable choices. Through this marathon, we aim to bring people of all ages together for fitness, awareness and positive action towards a healthier and greener community.
</p>
</div>
</section>

<!-- BENEFITS -->
<section class="benefits">
<div class="container">

<div class="section-label">PARTICIPANT BENEFITS</div>
<h2 class="section-title">MORE THAN JUST A RUN.</h2>

<div class="benefit-grid">

<div class="benefit">
